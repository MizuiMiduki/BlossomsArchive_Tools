# Gzip圧縮 (mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

# ブラウザキャッシュ設定 (mod_expires / mod_headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTMLは常に最新を取得させる
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"

    # 静的アセット（JS, CSS, 画像, フォント）は長期キャッシュ
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # セキュリティヘッダー
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # HTML・JSON・テキスト系マニフェストはキャッシュ検証を強制
    <FilesMatch "\.(html|htm|json|txt|xml)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # ハッシュ付き静的ファイルは immutable キャッシュ
    <FilesMatch "\.(js|css|webp|png|jpe?g|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# 末尾スラッシュなしディレクトリへのアクセス時にmod_dirがHTTPへ301リダイレクトするのを防止
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

# SPAのルーティング対応：存在しないファイル・ディレクトリへのアクセスをindex.htmlにリダイレクト
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 旧URLをpagesのない正規URLへ恒久リダイレクト
    RewriteRule ^pages/(.*)$ /$1 [R=301,L]

    # ARD (Agentic Resource Discovery) マニフェストの確実な配信
    RewriteRule ^\.well-known/ard\.json$ ard.json [L]

    # ルートアクセスはindex.htmlを直接配信
    RewriteRule ^$ index.html [L]

    # 存在するディレクトリ（末尾スラッシュ有無問わず）に index.html がある場合は301リダイレクトせず内部リライトで即座に返す
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+?)/?$ $1/index.html [L]

    # 実際に存在するファイルへのリクエストはそのまま通す
    RewriteCond %{REQUEST_FILENAME} !-f
    # 実際に存在するディレクトリへのリクエストはそのまま通す
    RewriteCond %{REQUEST_FILENAME} !-d

    # それ以外はすべてindex.htmlに渡す
    RewriteRule ^ index.html [QSA,L]
</IfModule>
